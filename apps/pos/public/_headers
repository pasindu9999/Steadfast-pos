# Cloudflare Pages response headers (ARCH §8.1). Pages joins the values of every rule that matches a
# path, so only one rule may set Cache-Control for any file.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Always checked with the server, so a new version is found at once.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# The name changes whenever the content does.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/workbox-*
  Cache-Control: public, max-age=31536000, immutable
