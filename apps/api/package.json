    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "@pos/core": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.2",
    "@pos/tsconfig": "workspace:*",
    "@types/node": "24.19.4",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
