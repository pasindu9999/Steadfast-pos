{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:render": "prisma migrate deploy && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/assert-local-database.mjs && prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "node scripts/assert-local-database.mjs && prisma migrate reset",
    "db:seed": "pnpm --filter @pos/core build && prisma generate && tsc -p tsconfig.seed.json && node dist-seed/prisma/seed.js",
    "db:seed:large": "pnpm db:seed --large",
    "db:seed:prod": "pnpm --filter @pos/core build && prisma generate && tsc -p tsconfig.seed.json && node --env-file=.env.production.local dist-seed/prisma/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "@nestjs/throttler": "6.8.0",
    "@pos/core": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.2",
    "@pos/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "12.2.2",
    "@types/node": "24.19.4",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
