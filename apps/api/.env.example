# Throwaway credentials for the local Docker database only (docker-compose.yml)
DATABASE_URL=postgresql://pos:pos@127.0.0.1:5432/pos

# Lets the demo enrolment codes be used again and again. Off unless set to true.
DEMO_MODE=true

# Optional. The values shown are the defaults.
# A direct connection for Prisma's commands, where DATABASE_URL goes through a pooler (production).
# DIRECT_URL=
# NODE_ENV=development
# PORT=3000
# LOG_LEVEL=info
# Comma-separated POS origins. Required when NODE_ENV=production.
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Reverse proxies in front of the API (1 on most hosts), so rate limits see the real client.
# TRUST_PROXY_HOPS=0
# Requests per minute per client. The second applies to terminal enrolment.
# RATE_LIMIT_PER_MINUTE=120
# ENROL_RATE_LIMIT_PER_MINUTE=10

# Seed only: demo enrolment codes (8 to 64 characters).
# SEED_ENROL_CODE_T1=DEMO-S01-T1
# SEED_ENROL_CODE_T2=DEMO-S01-T2

# `db:seed:prod` reads .env.production.local (git-ignored) instead of this file.
